{
  "expo": {
    "name": "Mini Deals Explorer",
    "slug": "mini-deals-explorer",
    "version": "1.0.0",
    "scheme": "minideals",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.amitsurwar.minidealsexplorer",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset"
    ]
  }
}
